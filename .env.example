# mock = runs on every laptop without hardware
# joypi_dht11 = reads the built-in Joy-Pi DHT11 sensor
SENSOR_TYPE=joypi_dht11

# This becomes MeasurementRequest.DeviceId in the C# backend.
DEVICE_ID=joypi-01

# Joy-Pi DHT11 uses BCM GPIO 4 according to the Joy-Pi manual.
DHT_PIN=4

# Your C# backend endpoint.
# Local backend example: http://localhost:5000/api/measurements
# Render example: https://YOUR-RENDER-SERVICE.onrender.com/api/measurements
ENDPOINT_URL=http://localhost:5000/api/measurements

# Must match API_KEY in the C# backend.
API_KEY=dev-secret

# How often to measure when running continuously.
INTERVAL_SECONDS=60

# The latest JSON file is exactly the MeasurementRequest payload sent to the backend.
OUTPUT_PATH=data/latest_measurement.json

# true = read/send once and exit; false = repeat forever
RUN_ONCE=true