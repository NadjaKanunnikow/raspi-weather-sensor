# mock = runs on every laptop without hardware
# dht11 = reads a DHT11 sensor on a Raspberry Pi GPIO pin
# dht22 = reads a DHT22/AM2302 sensor on a Raspberry Pi GPIO pin
SENSOR_TYPE=dht11
SENSOR_ID=classroom-pi-01

# For DHT11/DHT22: connect DATA to GPIO4 by default. In CircuitPython this is D4.
DHT_PIN=D4

# Backend endpoint. Local Express backend: http://localhost:3000/api/readings
# Later on Render: https://YOUR-RENDER-SERVICE.onrender.com/api/readings
ENDPOINT_URL=http://localhost:3000/api/readings

# Must match API_KEY in the backend.
API_KEY=change-me

# How often to measure when running continuously.
# DHT sensors should not be read too frequently. 60 seconds is safe for your project.
INTERVAL_SECONDS=60

# Where the latest reading should be written as JSON.
OUTPUT_PATH=data/latest_reading.json

# true = read/send once and exit; false = repeat forever
RUN_ONCE=true
